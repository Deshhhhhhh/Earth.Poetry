# ============================================
#   🌍 EARTH.POETRY — ENVIRONMENT VARIABLES
# ============================================
#
# 👉 Gemini API key — Get one from https://aistudio.google.com
#
# IMPORTANT for NETLIFY deployment:
#   You MUST set VITE_GEMINI_API_KEY in Netlify Environment Variables:
#     Netlify Dashboard → Your Site → Site settings → Environment variables
#   Then RE-DEPLOY your site after adding it!
#
# For LOCAL DEVELOPMENT:
#   Save as .env file next to this .env.example and restart dev server.

# Server-side key (used by local Node/Express server.ts in dev)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 👇 Client-side key (MUST be set on Netlify for production!)
#    Vite automatically exposes VITE_ prefixed vars to the browser bundle.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Your live website URL (used for share links)
APP_URL="MY_APP_URL"

# ============================================
# 🚀 Local development: npm run dev
# 📦 Build for Netlify:      npm run build → upload the dist/ folder
# ============================================
